# Local PostgreSQL (no Docker). Adjust user/password/db to match your install.
# macOS Homebrew example (peer auth, no password):
DATABASE_URL=postgresql+asyncpg://YOUR_USER@localhost:5432/autopm
# With password:
# DATABASE_URL=postgresql+asyncpg://YOUR_USER:YOUR_PASSWORD@localhost:5432/autopm

REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=your-fernet-key-generate-with-python-cryptography-fernet-generate-key

ANTHROPIC_API_KEY=
GITHUB_MCP_SERVER_URL=https://api.githubcopilot.com/mcp/
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Gevent worker: greenlets per process (not prefork workers). Set by dev-celery.sh:
# AUTOPM_CELERY_GEVENT=1
CELERY_WORKER_CONCURRENCY=10
CELERY_QUEUES=agent,default

# Optional — database seed (python seed.py)
SEED_COMPANY_NAME=AutoPM
SEED_COMPANY_SLUG=autopm
SEED_USER_EMAIL=admin@autopm.com
SEED_USER_NAME=Super Admin
SEED_USER_PASSWORD=changeme123
